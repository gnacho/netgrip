#!/bin/sh /etc/rc.common
# owpanel procd init script

START=99
STOP=10

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/owpanel -listen 0.0.0.0 -port 8080
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
